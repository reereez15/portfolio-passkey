# Aiven MySQL 연결 정보 (Aiven 콘솔의 Connection info에서 복사)
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=changeme
DB_NAME=defaultdb
# Aiven은 자체 서명 인증서를 쓰는 경우가 있어 CA 인증서 경로가 필요할 수 있음
# (Aiven 콘솔에서 ca.pem 다운로드 후 프로젝트 루트에 두고 아래 경로 지정)
DB_CA_PATH=./ca.pem
# Aiven 등 클라우드 DB 연결 시 true로. 로컬 개발 DB는 보통 false.
DB_SSL=true

# JWT 서명에 쓰는 비밀값 — 반드시 배포 전에 랜덤한 긴 문자열로 교체
JWT_SECRET=change-this-to-a-long-random-string

# WebAuthn 설정
# 개발 중에는 localhost, 배포 후에는 실제 도메인(포트/프로토콜 없이 호스트명만)
RP_ID=localhost
RP_NAME=김준식 포트폴리오
# 브라우저에서 접속하는 정확한 origin (프로토콜+도메인, 배포 후 https://xxx.onrender.com 등)
ORIGIN=http://localhost:3000

PORT=3000
